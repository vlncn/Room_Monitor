# Mosquitto Configuration

# InfluxDB Configuration
INFLUXDB_HTTP_PORT=8181             
INFLUXDB_HOST=influxdb3-core        
INFLUXDB_TOKEN=
INFLUXDB_BUCKET=ESP32_MQTT_Monitoring       
INFLUXDB_ORG=             
INFLUXDB_NODE_ID=node0            

# Grafana Configuration
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Telegraf Configuration
TELEGRAF_COLLECTION_INTERVAL=10s
TELEGRAF_LATITUDE=
TELEGRAF_LONGITUDE=
TELEGRAF_TOPIC_NOW=ROOM_LEVEL_1/now/data
TELEGRAF_TOPIC_OLD_DATA=ROOM_LEVEL_1/backlog/data
DOCKER_SOCKET=/var/run/docker.sock
