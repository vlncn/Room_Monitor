      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Temperature difference (room minus city, 5 min avg)",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "ag3xzqs9mq0owa"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "WITH room AS (\n  SELECT date_bin(INTERVAL '5 minutes', time) AS t, avg(temp) AS room_temp\n  FROM \"Room 1 Temperature\"\n  WHERE $__timeFilter(time)\n  GROUP BY 1\n), city AS (\n  SELECT date_bin(INTERVAL '5 minutes', time) AS t, avg(temp) AS city_temp\n  FROM \"City Temperature\"\n  WHERE $__timeFilter(time)\n  GROUP BY 1\n)\nSELECT room.t AS time, room.room_temp - city.city_temp AS \"Room - City\"\nFROM room\nJOIN city ON room.t = city.t\nORDER BY time"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
